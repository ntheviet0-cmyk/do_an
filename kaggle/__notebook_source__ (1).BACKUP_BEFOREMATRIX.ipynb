        if k in _mk:
            _fixed[k] = v
        elif k.startswith('ctx.') and ('ctx.embs.' + k[4:]) in _mk:
            _fixed['ctx.embs.' + k[4:]] = v; _n_remap += 1
        elif k.startswith('ctx.embs.') and ('ctx.' + k[9:]) in _mk:
            _fixed['ctx.' + k[9:]] = v; _n_remap += 1
        else:
            _fixed[k] = v
    _missing = sorted(_mk - set(_fixed))
    _unexpected = sorted(set(_fixed) - _mk)
    if _missing or _unexpected:
        raise ValueError(
            f'Checkpoint khong khop 100%: missing={_missing[:10]} unexpected={_unexpected[:10]} '
            '(khong dung strict=False de che giau loi kien truc).')
    tft.model.load_state_dict(_fixed, strict=True)
    tft.model.eval()
    print(f'loaded TFT tu checkpoint ({_n_remap} key remap, strict) | best_epoch={tft.best_epoch}')
else:
    print('dung tft trong RAM (vua train xong)')

# ---- 3. run fingerprint + dedicated cache dir ----
def _state_dict_fp(model):
    h = hashlib.sha1()
    sd = model.state_dict()
    for k in sorted(sd.keys()):
        v = sd[k].detach().cpu().numpy()
        h.update(k.encode('utf-8'))
        h.update(np.ascontiguousarray(v).tobytes())
    return h.hexdigest()

def _jsonable(obj):
    return json.loads(json.dumps(obj, sort_keys=True, default=str))

_weights_fp = _state_dict_fp(tft.model)
_cache_key = {
    'preprocess_version': PREPROCESS_VERSION,
    'config_version': CONFIG_VERSION,
    'weights_sha1': _weights_fp,
    'meta_history_len': len(getattr(tft, 'history', []) or []),
    'seq': int(tft.seq), 'H': int(tft.H),
    'd': int(tft.d), 'heads': int(tft.heads),
    'dropout': float(getattr(tft, 'dropout', 0.1)),
    'log_target': bool(tft.log_target),
    'target_transform': 'log1p_after_scaling' if tft.log_target else 'raw_after_scaling',
    'past_cols': list(map(str, tft.pc)),
    'fut_cols': list(map(str, tft.fc)),
    'static_cols': list(map(str, tft.sc)),
    **_EXPECTED_BOUNDARIES,
    'id_schema': 'M5 id = item_id + store_id, unique (id, d_num)',
    'maps_sha1': hashlib.sha1(json.dumps(_jsonable(tft.maps), sort_keys=True).encode()).hexdigest(),
    'cards': _jsonable(tft.cards),
}
RUN_FP = hashlib.sha1(json.dumps(_jsonable(_cache_key), sort_keys=True).encode()).hexdigest()[:16]
print('RUN_FP =', RUN_FP, '| weights_sha1 =', _weights_fp[:16], '...')

CACHE_DIR = os.path.join(OUT_DIR, f'predict_{RUN_FP}')
os.makedirs(CACHE_DIR, exist_ok=True)
_ck = _jsonable(_cache_key)
_fp_file = os.path.join(CACHE_DIR, 'fingerprint.json')
if os.path.isfile(_fp_file):
    with open(_fp_file, encoding='utf-8') as f:
        if json.load(f) != _ck:
            raise ValueError('Cache fingerprint mismatch (file vs current run). Dung ten dir rieng.')
else:
    with open(_fp_file, 'w', encoding='utf-8') as f:
        json.dump(_ck, f, indent=2, ensure_ascii=False)

_SPLITS = ['val', 'test']
_CACHE_FILES = [f'preds_{sp}.npz' for sp in _SPLITS] + [f'true_{sp}.npz' for sp in _SPLITS] + \
               [f'meta_{sp}.pkl' for sp in _SPLITS] + [f'done_{sp}.txt' for sp in _SPLITS] + ['fingerprint.json']

def _resume_from_input():
    hits = glob.glob(os.path.join('/kaggle/input', '**', f'predict_{RUN_FP}', 'fingerprint.json'), recursive=True)
    if not hits:
        return
    src = os.path.dirname(hits[0])
    try:
        with open(hits[0], encoding='utf-8') as f:
            if json.load(f) != _ck:
                print('resume source fingerprint mismatch -> ignore')
                return
    except Exception:
        return
    for fn in _CACHE_FILES:
        s_ = os.path.join(src, fn); d_ = os.path.join(CACHE_DIR, fn)
        if os.path.isfile(s_) and not os.path.isfile(d_):
            shutil.copy(s_, d_)
            print('  copied', fn)
_resume_from_input()

def _atomic_savez(path, d):
    tmp = path[:-4] + '.tmp.npz'
    np.savez(tmp, **d)
    os.replace(tmp, path)

def _atomic_pickle(path, obj):
    tmp = path + '.tmp'
    with open(tmp, 'wb') as f:
        pickle.dump(obj, f)
    os.replace(tmp, path)

# ---- 4. expected ids + coverage bookkeeping ----
expected_ids = sku_df['id'].drop_duplicates().tolist()
if len(set(expected_ids)) != len(expected_ids):
    raise ValueError('Duplicate ids in sku_df.')
expected_set = set(expected_ids)
print(f'expected series: {len(expected_ids):,}')

SPLIT_SPECS = {}
for _sp, (_st, _en) in {'val': (VAL_START, VAL_END), 'test': (TEST_START, TEST_END)}.items():
    SPLIT_SPECS[_sp] = {'start': int(_st), 'end': int(_en), 'ctx_end': int(_st) - 1,
                        'ctx_start': int(_st) - SEQ, 'n_days': int(_en) - int(_st) + 1}
    if SPLIT_SPECS[_sp]['n_days'] != H:
        raise ValueError(f'{_sp}: horizon {SPLIT_SPECS[_sp]["n_days"]} != H={H}')

def _run_split(split):
    spec = SPLIT_SPECS[split]
    preds_path = os.path.join(CACHE_DIR, f'preds_{split}.npz')
    true_path = os.path.join(CACHE_DIR, f'true_{split}.npz')
    meta_path = os.path.join(CACHE_DIR, f'meta_{split}.pkl')
    done_path = os.path.join(CACHE_DIR, f'done_{split}.txt')
    preds, trues, metas = {}, {}, {}
    if os.path.isfile(preds_path) and os.path.isfile(true_path) and os.path.isfile(meta_path):
        try:
            with np.load(preds_path) as zp, np.load(true_path) as zt:
                _pkeys = {k[5:]: k for k in zp.files if k.startswith('pred_')}
                _tkeys = {k[5:]: k for k in zt.files if k.startswith('true_')}
                for sid in set(_pkeys) & set(_tkeys):
                    if sid not in expected_set:
                        continue
                    p = zp[_pkeys[sid]]; y = zt[_tkeys[sid]]
                    if p.shape != (H,) or y.shape != (H,):
                        continue
                    if not np.isfinite(p).all() or not np.isfinite(y).all():
                        continue
                    preds[sid] = p.astype(np.float64); trues[sid] = y.astype(np.float64)
            with open(meta_path, 'rb') as f:
                metas = pickle.load(f)
            metas = {k: v for k, v in metas.items() if k in preds}
            preds = {k: v for k, v in preds.items() if k in metas}
            trues = {k: v for k, v in trues.items() if k in metas}
        except Exception as e:
            print(f'[{split}] cache load failed ({e}) -> predict lai tu dau')
            preds, trues, metas = {}, {}, {}
    done = set(preds)
    print(f'[{split}] resumed {len(done):,}/{len(expected_ids):,}')

    todo = [sid for sid in expected_ids if sid not in done]
    todo_set = set(todo)
    reasons = {}
    buf_d = []
    CHUNK = 5000
    n = 0
    for sid, g in sku_df.groupby('id', sort=False, observed=True):
        if sid not in todo_set:
            continue
        g = g.sort_values('d_num').reset_index(drop=True)
        d = g['d_num'].to_numpy(np.int64)
        ctx = g[(d >= spec['ctx_start']) & (d <= spec['ctx_end'])]
        fut = g[(d >= spec['start']) & (d <= spec['end'])]
        if (len(ctx) != SEQ or int(ctx['d_num'].iloc[-1]) != spec['ctx_end']
                or not np.all(np.diff(ctx['d_num'].to_numpy(np.int64)) == 1)):
            reasons[sid] = 'insufficient_encoder_context'; continue
        if (len(fut) != H or not np.array_equal(fut['d_num'].to_numpy(np.int64),
                                                 np.arange(spec['start'], spec['end'] + 1, dtype=np.int64))):
            reasons[sid] = 'missing_forecast_days'; continue
        y = fut['sales'].to_numpy(np.float64)
        try:
            p = np.asarray(tft.predict_median(ctx, fut), dtype=np.float64)
        except Exception as e:
            reasons[sid] = f'predict_error:{type(e).__name__}'; continue
        if p.shape != (H,) or not np.isfinite(p).all() or (p < 0).any():
            reasons[sid] = 'invalid_prediction'; continue
        preds[sid] = p; trues[sid] = y
        metas[sid] = (str(fut['store_id'].iloc[0]), str(fut['state_id'].iloc[0]),
                      str(fut['dept_id'].iloc[0]), int(spec['ctx_end']))
        buf_d.append(sid)
        n += 1
        if n % CHUNK == 0 or n == len(todo):
            _atomic_savez(preds_path, {f'pred_{k}': v.astype(np.float32) for k, v in preds.items()})
            _atomic_savez(true_path, {f'true_{k}': v.astype(np.float32) for k, v in trues.items()})
            _atomic_pickle(meta_path, metas)
            with open(done_path, 'a', encoding='utf-8') as f:
                f.write('\n'.join(buf_d) + '\n')
                f.flush()
            buf_d = []
            gc.collect()
            if torch.cuda.is_available():
                torch.cuda.empty_cache()
            print(f'  [{split}] {n:,}/{len(todo):,} new (total {len(preds):,}/{len(expected_ids):,}) ckpt saved')

    missing = [sid for sid in expected_ids if sid not in preds]
    cov = pd.DataFrame({
        'series_id': expected_ids,
        'predicted': [sid in preds for sid in expected_ids],
        'reason': [reasons.get(sid, '') for sid in expected_ids],
    })
    cov.to_csv(os.path.join(OUT_DIR, f'coverage_predict_{split}.csv'), index=False)
    bad_meta = sum(1 for sid in preds if metas.get(sid, ('', '', '', -1))[3] != spec['ctx_end'])
    if bad_meta:
        raise ValueError(f'[{split}] {bad_meta} series have wrong forecast origin in meta.')
    print(f'[{split}] predicted {len(preds):,}/{len(expected_ids):,} | missing {len(missing):,} | '
          f'origin d_{spec["ctx_end"]} -> targets d_{spec["start"]}..d_{spec["end"]}')
    if missing:
        _rs = pd.Series([reasons.get(s, "unknown") for s in missing]).value_counts().to_dict()
        raise ValueError(f'[{split}] coverage incomplete: {len(missing):,} missing, reasons={_rs}')
    return preds, trues, metas

print('\n--- Predict VAL (encoder d_1802..d_1857) ---')
tft_L12_val, true_L12_val, meta_L12_val = _run_split('val')
print('\n--- Predict TEST (encoder d_1830..d_1885) ---')
tft_L12, true_L12, meta_L12 = _run_split('test')

COVERAGE_DF = pd.concat([
