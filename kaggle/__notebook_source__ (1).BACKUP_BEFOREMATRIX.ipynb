import gc, warnings
import numpy as np
import pandas as pd

warnings.filterwarnings('ignore')

# ---- 0. cau hinh chot: FULL, khong sample ----
TRAIN_SAMPLE_N = None
print(f'TRAIN_SAMPLE_N = {TRAIN_SAMPLE_N} (None = full 30.490 series)')

# ---- 1. FEATURE CONFIG (phuong an A: gia chi lagged, future chi lich) ----
# PAST   : observed at/before the forecast origin (sales + lags >= 28 + lagged prices).
# FUT    : known in advance for the whole horizon (calendar / SNAP / events only).
# STATIC : time-invariant categorical identity (embedded).
PAST = [
    'sales',
    'sales_lag_28',
    'sales_lag_35',
    'sales_rolling_mean_7',
    'sales_rolling_mean_28',
    'sell_price_lag_28',
    'price_discount_lag_28',
    'price_momentum_lag_28',
    'sell_price_rolling_mean_7',
    'is_listed',
    'is_listed_lag_28',
]
FUT = [
    'is_weekend',
    'sin_wday',
    'cos_wday',
    'sin_month',
    'cos_month',
    'snap_active',
    'has_event',
    'event_count',
    'evt_Cultural',
    'evt_Religious',
    'evt_Sporting',
    'evt_National',
    'days_to_next_event',
    'days_since_last_event'
]
STATIC = ['store_id', 'state_id', 'cat_id', 'dept_id', 'item_id']
NUMERIC_FEATURES = list(dict.fromkeys(PAST + FUT))
REQUIRED_COLS = list(dict.fromkeys(['id', 'd_num', 'sales'] + PAST + FUT + STATIC))

# ---- 2. CONFIG CHECK ----
if 'sku_df' not in globals():
    raise NameError("sku_df chua co: chay cell PIPELINE 5 cap truoc.")
if 'SEQ' not in globals() or 'H' not in globals():
    raise NameError("Chua co SEQ/H: chay cell CONFIG dau tien.")
if 'TFT_CFG' not in globals():
    raise NameError("Chua co TFT_CFG: chay cell CONFIG dau tien.")
if 'TFTGlobalForecaster' not in globals():
    raise NameError("Chua co TFTGlobalForecaster: chay cell DINH NGHIA MODEL (ban fixed mask + lazy) truoc.")
if 'OUT_DIR' not in globals():
    OUT_DIR = '/kaggle/working' if os.path.isdir('/kaggle/working') else 'kaggle_out'
    os.makedirs(OUT_DIR, exist_ok=True)
if not isinstance(sku_df, pd.DataFrame) or sku_df.empty:
    raise ValueError("sku_df rong hoac khong phai DataFrame.")
if SEQ <= 0 or H <= 0:
    raise ValueError("SEQ va H phai > 0.")

# ---- 3. VALIDATE COLUMNS ----
missing_cols = [c for c in REQUIRED_COLS if c not in sku_df.columns]
if missing_cols:
    raise ValueError("sku_df thieu cot: " + ", ".join(missing_cols))
print(f"Input columns OK | rows: {len(sku_df):,} | series: {sku_df['id'].nunique():,}")

# ---- 4. BASIC VALIDATION (copy, khong sua nguon) ----

if sku_df['id'].isna().any():
    raise ValueError("sku_df co ID thieu.")
if (sku_df['sales'] < 0).any():
    raise ValueError("sales am: log1p target khong hop le.")
sku_df['d_num'] = pd.to_numeric(sku_df['d_num'], errors='coerce')
if sku_df['d_num'].isna().any():
    raise ValueError("d_num co gia tri khong hop le.")
sku_df = sku_df.sort_values(['id', 'd_num']).reset_index(drop=True)
if sku_df.duplicated(['id', 'd_num']).any():
    raise ValueError("Trung cap (id, d_num).")

# ---- 5. CLEAN NUMERIC (khong bfill de tranh lay tuong lai dien qua khu) ----
for col in NUMERIC_FEATURES:
    sku_df[col] = pd.to_numeric(sku_df[col], errors='coerce')
sku_df[NUMERIC_FEATURES] = sku_df[NUMERIC_FEATURES].replace([np.inf, -np.inf], np.nan)

# ---- 6. REMOVE INVALID ROWS ----
rows_before = len(sku_df)
invalid_rows = sku_df[STATIC].isna().any(axis=1) | sku_df[NUMERIC_FEATURES].isna().any(axis=1)
print(f"Rows before: {rows_before:,} | invalid (warmup thieu lag): {invalid_rows.sum():,}")
sku_df = sku_df.loc[~invalid_rows].sort_values(['id', 'd_num']).reset_index(drop=True)
