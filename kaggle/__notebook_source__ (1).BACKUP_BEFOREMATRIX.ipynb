# FINAL AUDIT + LIGHTWEIGHT UNIT TESTS
# ============================================================
import hashlib
import json
import numpy as np
import pandas as pd
import torch

_PASS, _FAIL = 0, []
def _check(name, cond, detail=''):
    global _PASS
    ok = bool(cond)
    if ok:
        _PASS += 1
    else:
        _FAIL.append((name, str(detail)))
    print(('[PASS] ' if ok else '[FAIL] ') + name + ('' if ok else f' :: {detail}'))

# 1. boundary config
_check('fixed boundary arithmetic',
       TRAIN_TARGET_START == SEQ + 1 and VAL_START == TRAIN_TARGET_END + 1
       and TEST_START == VAL_END + 1 and TEST_END == END_DAY
       and VAL_END - VAL_START + 1 == H and TEST_END - TEST_START + 1 == H,
       f'{TRAIN_TARGET_START=} {TRAIN_TARGET_END=} {VAL_START=} {VAL_END=} {TEST_START=} {TEST_END=}')

# 2. split build audit
if 'SPLIT_AUDIT' in globals():
    _sa = SPLIT_AUDIT
    _check('split audit: no val/test rows in train', _sa.get('no_val_test_rows_in_train', False), _sa)
    _check('split audit: train==val==test cardinality',
           _sa['n_train'] == _sa['n_val'] == _sa['n_test'] and _sa['n_train'] > 0, _sa)
else:
    _check('split audit present', False, 'SPLIT_AUDIT missing')

# 3. split_df uses fixed boundaries
if 'split_df' in globals():
    _toy = pd.DataFrame({'d_num': np.arange(START_DAY, END_DAY + 1, dtype=np.int64)})
    _tr, _va, _te = split_df(_toy)
    _check('split_df fixed boundaries',
           int(_tr['d_num'].max()) == TRAIN_TARGET_END and int(_va['d_num'].min()) == VAL_START
           and int(_va['d_num'].max()) == VAL_END and int(_te['d_num'].min()) == TEST_START
           and int(_te['d_num'].max()) == TEST_END,
           f'tr_max={int(_tr["d_num"].max())} va=[{int(_va["d_num"].min())},{int(_va["d_num"].max())}] te=[{int(_te["d_num"].min())},{int(_te["d_num"].max())}]')
else:
    _check('split_df present', False, 'split_df missing')

# 4. features exist + no duplicates
_schema = list(map(str, tft.pc)) + list(map(str, tft.fc)) + list(map(str, tft.sc))
_missf = [c for c in _schema if c not in sku_df.columns]
_check('feature schema columns exist', not _missf, str(_missf))
_check('unique (id, d_num)', not sku_df.duplicated(['id', 'd_num']).any())
_ok_nan = True
for _c in list(map(str, tft.pc)) + list(map(str, tft.fc)):
    if sku_df[_c].isna().any():
        _ok_nan = False
        break
_check('no NaN in model feature columns', _ok_nan)

# 5. FUT (known future) contains no sales/price leakage
_leak = [c for c in tft.fc if c.startswith('sales') or ('price' in c) or ('discount' in c)]
_check('FUT has no sales/price columns', not _leak, str(_leak))
if 'PAST' in globals():
    _check('checkpoint schema == notebook PAST/FUT/STATIC',
           list(map(str, tft.pc)) == list(map(str, PAST)) and list(map(str, tft.fc)) == list(map(str, FUT))
           and list(map(str, tft.sc)) == list(map(str, STATIC)), 'schema differs')

# 6. lag / rolling alignment on 3 sample series (no future leak into past features)
_samples = {}
for _sid, _g in sku_df.groupby('id', sort=False, observed=True):
    _samples[_sid] = _g.sort_values('d_num').reset_index(drop=True)
    if len(_samples) >= 3:
        break
_ok_lag = True; _ok_roll = True
for _sid, _g in _samples.items():
    for _lag in (28, 35):
        _lhs = _g['sales_lag_' + str(_lag)].to_numpy(np.float64)
        _rhs = _g['sales'].shift(_lag).to_numpy(np.float64)
        _ok_lag &= bool(np.allclose(_lhs[_lag:], _rhs[_lag:], equal_nan=True))
    if len(_g) > 40:
        _rhs = _g['sales'].shift(28).rolling(7, min_periods=1).mean().to_numpy(np.float64)
        _lhs = _g['sales_rolling_mean_7'].to_numpy(np.float64)
        _m = np.arange(len(_g)) >= 28
        _ok_roll &= bool(np.allclose(_lhs[_m], _rhs[_m], atol=1e-5))
_check('sales lag alignment (t-lag, lag>=28)', _ok_lag)
_check('rolling mean uses shift(28) then window', _ok_roll)
del _samples

# 7. target transform roundtrip (inverse order: inverse scaling then expm1)
_yv = np.array([0., 1., 2.5, 7., 28.], dtype=np.float64)
_back = np.expm1(tft.ts.inverse_transform(tft.ts.transform(np.log1p(_yv).reshape(-1, 1))).ravel())
_check('log1p + scaler roundtrip', np.allclose(_back, _yv, atol=1e-5), str(_back))
_check('median head index is q=0.5', list(QuantileLoss().q) == [0.1, 0.5, 0.9])

# 8. metrics edge cases
_check('WMAPE known value', abs(calc_wmape([2., 0., 4.], [1., 0., 4.]) - 100.0 * 1.0 / 6.0) < 1e-9)
_check('WMAPE zero denominator -> NaN', bool(np.isnan(calc_wmape([0., 0.], [1., 2.]))))

# 9. checkpoint identity + cache fingerprint
_check('checkpoint fingerprint stable', _state_dict_fp(tft.model) == _cache_key['weights_sha1'])
with open(os.path.join(CACHE_DIR, 'fingerprint.json'), encoding='utf-8') as _f:
    _fpc = json.load(_f)
_check('cache fingerprint file matches current run', _fpc == _cache_key)
_alt_key = dict(_cache_key); _alt_key['seq'] = int(_cache_key['seq']) + 1
_alt_fp = hashlib.sha1(json.dumps(_jsonable(_alt_key), sort_keys=True).encode()).hexdigest()[:16]
_check('cache fingerprint changes when config changes', _alt_fp != RUN_FP)

# 10. coverage + origins
_cov = pd.read_csv(os.path.join(OUT_DIR, 'coverage_predict.csv'))
_check('prediction coverage 100%', bool(_cov['predicted'].all()),
       f"missing={int((~_cov['predicted']).sum())}")
_check('val forecast origin == TRAIN_TARGET_END',
       all(v[3] == TRAIN_TARGET_END for v in meta_L12_val.values()))
_check('test forecast origin == VAL_END', all(v[3] == VAL_END for v in meta_L12.values()))

# 11. hierarchy expected counts
_ok_counts = True
for _split, _preds, _metas in (('val', tft_L12_val, meta_L12_val), ('test', tft_L12, meta_L12)):
    _k9 = {f'{_metas[s][0]}|{_metas[s][1]}' for s in _preds}
    _k3 = {_metas[s][0] for s in _preds}
    _k2 = {_metas[s][1] for s in _preds}
    _ok_counts &= (len(_preds) == EXPECTED_COUNTS['L12'] and len(_k9) == EXPECTED_COUNTS['L9']
                   and len(_k3) == EXPECTED_COUNTS['L3'] and len(_k2) == EXPECTED_COUNTS['L2'])
_check('hierarchy expected counts (id/store|dept/store/state)', _ok_counts, str(EXPECTED_COUNTS))

# 12. metrics finite on original scale + reconciliation
_mcols = ['WMAPE_TFT (%)', 'MAE_TFT', 'RMSE_TFT', 'Bias_TFT', 'total_actual', 'total_pred']
_check('eval metrics finite on original scale',
       bool(np.isfinite(EVAL_RESULTS[_mcols].to_numpy(dtype=np.float64)).all()))
_check('hierarchy reconciliation ~0', RECON_MAX < 1e-6, str(RECON_MAX))

print('\n' + '=' * 60)
print(f'AUDIT SUMMARY: {_PASS} passed, {len(_FAIL)} failed')
if _FAIL:
    for _n, _d in _FAIL:
        print('  FAILED:', _n, '::', _d)
    raise AssertionError(f'{len(_FAIL)} audit checks failed.')
print('ALL AUDIT CHECKS PASSED')
