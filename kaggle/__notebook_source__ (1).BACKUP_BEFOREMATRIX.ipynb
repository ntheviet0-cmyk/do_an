# ---- 7. TIME SPLIT (explicit fixed boundaries, NEVER per-series max date) ----
def split_df(g):
    tr = g[g['d_num'] <= TRAIN_TARGET_END].copy()
    va = g[(g['d_num'] >= VAL_START) & (g['d_num'] <= VAL_END)].copy()
    te = g[(g['d_num'] >= TEST_START) & (g['d_num'] <= TEST_END)].copy()
    return tr, va, te

def _contiguous(d):
    d = np.asarray(d, dtype=np.int64)
    return d.size <= 1 or bool(np.all(np.diff(d) == 1))

VAL_DAYS = np.arange(VAL_START, VAL_END + 1, dtype=np.int64)
TEST_DAYS = np.arange(TEST_START, TEST_END + 1, dtype=np.int64)

def _count_train_windows(d):
    # Count k with d[k+SEQ] >= TRAIN_TARGET_START and d[k+SEQ+H-1] <= TRAIN_TARGET_END.
    d = np.asarray(d, dtype=np.int64)
    if d.size < SEQ + H:
        return 0
    k_lo = max(0, int(np.searchsorted(d, TRAIN_TARGET_START, side='left')) - SEQ)
    k_hi = min(int(np.searchsorted(d, TRAIN_TARGET_END, side='right')) - SEQ - H,
               d.size - SEQ - H)
    return max(0, k_hi - k_lo + 1)

# ---- 8. SELECT SERIES: FULL (TRAIN_SAMPLE_N=None) ----
all_ids = sku_df['id'].drop_duplicates().tolist()
if len(set(all_ids)) != len(all_ids):
    raise ValueError('Duplicate series ids in sku_df.')
sampled = all_ids
print(f"Using ALL series for TFT training: {len(sampled):,}")

# ---- 9. BUILD TRAIN/VAL/TEST WITH FIXED BOUNDARIES ----
sampled_set = set(sampled)
train_dfs, valid_dfs, test_dfs = [], [], []
excluded = {'gappy': 0, 'short_train': 0, 'no_train_window': 0,
            'bad_val_days': 0, 'bad_test_days': 0}
keep_cols = list(dict.fromkeys(['id', 'd_num', 'sales'] + PAST + FUT + STATIC))
for sid, g in sku_df.groupby('id', sort=False, observed=True):
    if sid not in sampled_set:
        continue
    g = g.sort_values('d_num').reset_index(drop=True)
    if not _contiguous(g['d_num']):
        excluded['gappy'] += 1; continue
    tr, va, te = split_df(g)
    if len(tr) < SEQ:
        excluded['short_train'] += 1; continue
    if _count_train_windows(tr['d_num']) <= 0:
        excluded['no_train_window'] += 1; continue
    if len(va) != H or not np.array_equal(va['d_num'].to_numpy(np.int64), VAL_DAYS):
        excluded['bad_val_days'] += 1; continue
    if len(te) != H or not np.array_equal(te['d_num'].to_numpy(np.int64), TEST_DAYS):
        excluded['bad_test_days'] += 1; continue
    train_dfs.append(tr[keep_cols].copy())
    valid_dfs.append(va[keep_cols].copy())
    test_dfs.append(te[keep_cols].copy())

print(f"Train/Val/Test series: {len(train_dfs):,}/{len(valid_dfs):,}/{len(test_dfs):,}")
print(f"Excluded: {excluded}")
if len(train_dfs) != len(valid_dfs) or len(train_dfs) != len(test_dfs):
    raise ValueError('Split cardinality mismatch (train/val/test).')
if not train_dfs:
    raise ValueError("Khong co chuoi du dai de train.")
if max(int(x['d_num'].max()) for x in train_dfs) > TRAIN_TARGET_END:
    raise ValueError('Train frame contains days after TRAIN_TARGET_END (leak).')

coverage_train = pd.DataFrame({
    'expected_series': [len(all_ids)],
    'built_series': [len(train_dfs)],
    **{k: [v] for k, v in excluded.items()},
    'train_target_start': [TRAIN_TARGET_START], 'train_target_end': [TRAIN_TARGET_END],
    'val_start': [VAL_START], 'val_end': [VAL_END],
    'test_start': [TEST_START], 'test_end': [TEST_END],
})
coverage_train.to_csv(os.path.join(OUT_DIR, 'coverage_train.csv'), index=False)
print(coverage_train.to_string(index=False))

SPLIT_AUDIT = {
    'n_train': len(train_dfs), 'n_val': len(valid_dfs), 'n_test': len(test_dfs),
    'train_days_min': min(int(x['d_num'].min()) for x in train_dfs),
    'train_days_max': max(int(x['d_num'].max()) for x in train_dfs),
    'no_val_test_rows_in_train': bool(max(int(x['d_num'].max()) for x in train_dfs) <= TRAIN_TARGET_END),
    'val_days': (int(VAL_START), int(VAL_END)),
    'test_days': (int(TEST_START), int(TEST_END)),
    'excluded': dict(excluded),
    'expected_series': len(all_ids),
}
del sampled_set; gc.collect()

# ---- 10. FINAL VALIDATION (spot check 200 series) ----
for i in np.random.RandomState(42).choice(len(train_dfs), size=min(200, len(train_dfs)), replace=False):
    s = train_dfs[int(i)]
    if [c for c in REQUIRED_COLS if c not in s.columns]:
        raise ValueError(f"Train series #{i} thieu cot.")
    if not np.isfinite(s[NUMERIC_FEATURES].to_numpy(dtype=np.float64)).all():
        raise ValueError(f"Train series #{i} co NaN/Inf.")
    if (s['sales'] < 0).any():
        raise ValueError(f"Train series #{i} sales am.")
print("Final validation passed (200-series spot check).")

# ---- 11. FIT (lazy windows; validation fixed at d_1858..d_1885) ----
