], ignore_index=True)
COVERAGE_DF.to_csv(os.path.join(OUT_DIR, 'coverage_predict.csv'), index=False)
print(f'\nPREDICT DONE | val: {len(tft_L12_val):,} | test: {len(tft_L12):,} | '
      f'expected: {len(expected_ids):,} | cache: {CACHE_DIR}')


# ============================================================
# EVAL: TFT vs SEASONAL-NAIVE BLOCK (val + test, 5 levels, bottom-up)
# MAPE intentionally excluded (undefined / meaningless with zero-inflated sales).
# Seasonal-naive block = last H observed values before the forecast origin,
# used as the forecast for days 1..H (block repeat semantics, made explicit).
# ============================================================
import os
import numpy as np
import pandas as pd

for _need in ['tft_L12', 'true_L12', 'meta_L12', 'tft_L12_val', 'true_L12_val', 'meta_L12_val']:
    if _need not in globals():
        raise NameError(f"Thieu '{_need}': chay cell PREDICT truoc.")

def _pivot_actuals():
    days = sorted(set(range(VAL_START - H, VAL_END + 1)) | set(range(TEST_START - H, TEST_END + 1)))
    sub = sku_df.loc[sku_df['d_num'].isin(days), ['id', 'd_num', 'sales']]
    if sub.duplicated(['id', 'd_num']).any():
        raise ValueError('duplicated (id, d_num) in sku_df.')
    piv = sub.pivot(index='id', columns='d_num', values='sales')
    return piv

PIV = _pivot_actuals()

def _block(piv, ids, start, end):
    cols = list(range(int(start), int(end) + 1))
    missing_cols = [c for c in cols if c not in piv.columns]
    if missing_cols:
        raise ValueError(f'Missing days {missing_cols[:5]} in sku_df pivot.')
    mat = piv.reindex(ids)[cols].to_numpy(dtype=np.float64)
    if not np.isfinite(mat).all():
        raise ValueError('Non-finite actuals for requested ids/days.')
    return mat

def _eval_split(split):
    if split == 'val':
        preds, trues, metas = tft_L12_val, true_L12_val, meta_L12_val
        start, end = VAL_START, VAL_END
    else:
        preds, trues, metas = tft_L12, true_L12, meta_L12
        start, end = TEST_START, TEST_END
    ids = sorted(sid for sid in preds if sid in trues and sid in metas)
    if len(ids) != len(preds):
        raise ValueError(f'[{split}] preds/true/meta key mismatch.')
    y = np.stack([np.asarray(trues[s], dtype=np.float64) for s in ids])
    p = np.stack([np.asarray(preds[s], dtype=np.float64) for s in ids])
    y_actual = _block(PIV, ids, start, end)
    naive = _block(PIV, ids, start - H, start - 1)
    if not np.allclose(y, y_actual, atol=1e-3):
        raise ValueError(f'[{split}] cached true arrays do not match sku_df actuals.')
    if y.shape != (len(ids), H):
        raise ValueError(f'[{split}] unexpected shape {y.shape}.')
    if not np.isfinite(p).all():
        raise ValueError(f'[{split}] non-finite predictions.')
    return {
        'split': split, 'ids': ids, 'start': int(start), 'end': int(end),
        'origin_end': int(start) - 1,
        'y': y, 'pred': p, 'naive': naive,
        'store': np.array([str(metas[s][0]) for s in ids]),
        'state': np.array([str(metas[s][1]) for s in ids]),
        'dept': np.array([str(metas[s][2]) for s in ids]),
    }

def _agg_by(mat, keys):
    keys = np.asarray(keys, dtype=object)
    out = {}
    for k in pd.unique(keys):
        out[str(k)] = mat[keys == k].sum(axis=0)
    return out

LEVELS = ['L12', 'L9', 'L3', 'L2', 'L1']

def _level_keys(R, level):
    if level == 'L12':
        return list(R['ids'])
    if level == 'L9':
        return [f'{s}|{d}' for s, d in zip(R['store'], R['dept'])]
    if level == 'L3':
        return list(R['store'])
    if level == 'L2':
        return list(R['state'])
    return ['ALL'] * len(R['ids'])

_raw_meta = pd.read_csv(os.path.join(DATA_DIR, 'sales_train_validation.csv'),
                        usecols=['id', 'dept_id', 'store_id', 'state_id'])
EXPECTED_COUNTS = {
    'L12': int(_raw_meta['id'].nunique()),
    'L9': int(_raw_meta[['store_id', 'dept_id']].drop_duplicates().shape[0]),
    'L3': int(_raw_meta['store_id'].nunique()),
    'L2': int(_raw_meta['state_id'].nunique()),
    'L1': 1,
}
print('Expected hierarchy counts (full data):', EXPECTED_COUNTS)
del _raw_meta

SPLIT_DATA = {split: _eval_split(split) for split in ('val', 'test')}

RESULTS = []
RECON_MAX = 0.0
for split, R in SPLIT_DATA.items():
    agg_pred, agg_true, agg_naive = {}, {}, {}
    for lv in LEVELS:
        keys = _level_keys(R, lv)
        agg_pred[lv] = _agg_by(R['pred'], keys)
        agg_true[lv] = _agg_by(R['y'], keys)
        agg_naive[lv] = _agg_by(R['naive'], keys)
        got = len(agg_pred[lv])
        if got != EXPECTED_COUNTS[lv]:
            raise ValueError(f'[{split}/{lv}] key count {got} != expected {EXPECTED_COUNTS[lv]}. '
                             'Kiem tra coverage/aggregation truoc khi doc metrics.')
        ref = _agg_by(R['pred'], _level_keys(R, lv))
        for k in ref:
            RECON_MAX = max(RECON_MAX, float(np.abs(ref[k] - agg_pred[lv][k]).max()))
    for lv in LEVELS:
        keys = list(agg_pred[lv].keys())
        yl = np.stack([agg_true[lv][k] for k in keys])
        pl = np.clip(np.stack([agg_pred[lv][k] for k in keys]), 0, None)
        nl = np.clip(np.stack([agg_naive[lv][k] for k in keys]), 0, None)
        mt = forecast_metrics(yl, pl, label=f'{split}/{lv}/TFT')
        mn = forecast_metrics(yl, nl, label=f'{split}/{lv}/naive')
        RESULTS.append({
            'split': split, 'level': lv, 'n_keys': len(keys),
            'n_obs': mt['n_obs'],
            'total_actual': mt['total_actual'], 'total_pred': mt['total_pred'],
            'pred_actual_ratio': mt['pred_actual_ratio'],
            'WMAPE_TFT (%)': mt['WMAPE (%)'], 'WMAPE_naive (%)': mn['WMAPE (%)'],
            'gap_vs_naive (%)': mt['WMAPE (%)'] - mn['WMAPE (%)'],
            'MAE_TFT': mt['MAE'], 'RMSE_TFT': mt['RMSE'], 'Bias_TFT': mt['Bias'],
            'sMAPE_TFT (%)': mt['sMAPE (%)'],
            'zero_actual_frac': mt['zero_actual_frac'],
            'zero_true_keys': int((yl.sum(1) == 0).sum()),
            'coverage_series': len(R['ids']),
        })
    print(f'[{split}] origin d_{R["origin_end"]} -> targets d_{R["start"]}..d_{R["end"]} | '
          f'series={len(R["ids"]):,}')

EVAL_RESULTS = pd.DataFrame(RESULTS)
print('\n' + '=' * 118)
print('TFT 5-LEVEL BOTTOM-UP EVAL vs SEASONAL-NAIVE BLOCK (val + test) | MAPE excluded (zero-inflation)')
print('=' * 118)
print(EVAL_RESULTS.to_string(index=False, float_format=lambda x: f'{x:,.4f}'))
EVAL_RESULTS.to_csv(os.path.join(OUT_DIR, 'hierarchical_5levels_tft_v3.csv'), index=False)
print('\nmax reconciliation error (TFT):', RECON_MAX)
print('saved:', os.path.join(OUT_DIR, 'hierarchical_5levels_tft_v3.csv'))

# ---- per-horizon WMAPE (days 1..H), all levels, both splits ----
def _wm_by_horizon(y, p):
    den = np.abs(y).sum(0)
    num = np.abs(y - p).sum(0)
    w = np.divide(num, den, out=np.full(num.shape, np.nan, dtype=np.float64), where=den != 0)
    return w * 100.0

HORIZON_ROWS = []
for split, R in SPLIT_DATA.items():
    for lv in LEVELS:
        keys = _level_keys(R, lv)
        ap = _agg_by(R['pred'], keys); ay = _agg_by(R['y'], keys); an = _agg_by(R['naive'], keys)
        ks = list(ap.keys())
        yl = np.stack([ay[k] for k in ks])
        pl = np.stack([ap[k] for k in ks])
        nl = np.stack([an[k] for k in ks])
        wt = _wm_by_horizon(yl, pl); wn = _wm_by_horizon(yl, nl)
        for h in range(H):
            HORIZON_ROWS.append({
                'split': split, 'level': lv, 'horizon_day': h + 1,
                'WMAPE_TFT (%)': float(wt[h]), 'WMAPE_naive (%)': float(wn[h]),
                'MAE_TFT': float(np.abs(yl[:, h] - pl[:, h]).mean()),
            })
HORIZON_DF = pd.DataFrame(HORIZON_ROWS)
HORIZON_DF.to_csv(os.path.join(OUT_DIR, 'metrics_per_horizon.csv'), index=False)
print('saved:', os.path.join(OUT_DIR, 'metrics_per_horizon.csv'))


