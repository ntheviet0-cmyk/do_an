sku_df['d_num'] = pd.to_numeric(sku_df['d_num'], errors='coerce')
if sku_df['d_num'].isna().any():
    raise ValueError("d_num co gia tri khong hop le.")
sku_df = sku_df.sort_values(['id', 'd_num']).reset_index(drop=True)
if sku_df.duplicated(['id', 'd_num']).any():
    raise ValueError("Trung cap (id, d_num).")

# ---- 5. CLEAN NUMERIC (khong bfill de tranh lay tuong lai dien qua khu) ----
for col in NUMERIC_FEATURES:
    sku_df[col] = pd.to_numeric(sku_df[col], errors='coerce')
sku_df[NUMERIC_FEATURES] = sku_df[NUMERIC_FEATURES].replace([np.inf, -np.inf], np.nan)

# ---- 6. REMOVE INVALID ROWS ----
rows_before = len(sku_df)
invalid_rows = sku_df[STATIC].isna().any(axis=1) | sku_df[NUMERIC_FEATURES].isna().any(axis=1)
print(f"Rows before: {rows_before:,} | invalid (warmup thieu lag): {invalid_rows.sum():,}")
sku_df = sku_df.loc[~invalid_rows].sort_values(['id', 'd_num']).reset_index(drop=True)
print(f"Rows after: {len(sku_df):,} | series: {sku_df['id'].nunique():,}")
if sku_df.empty:
    raise ValueError("Khong con du lieu sau lam sach.")
clean_array = sku_df[NUMERIC_FEATURES].to_numpy(dtype=np.float64)
if not np.isfinite(clean_array).all():
    raise ValueError("Van con NaN/Inf sau lam sach.")
del clean_array; gc.collect()
print("Numeric validation passed.")

# ---- 7. TIME SPLIT ----
def split_df(g, key='d_num'):
    md = g[key].max()
    return (g[g[key] <= md - 56].copy(),
            g[(g[key] > md - 56) & (g[key] <= md - 28)].copy(),
            g[g[key] > md - 28].copy())

# ---- 8. SELECT SERIES: FULL (TRAIN_SAMPLE_N=None) ----
all_ids = sku_df['id'].drop_duplicates().tolist()
sampled = all_ids
print(f"Using ALL series for TFT training: {len(sampled):,}")

# ---- 9. BUILD TRAIN/VAL/TEST ----
sampled_set = set(sampled)
train_dfs, valid_dfs, test_dfs = [], [], []
excluded = {'short_train': 0, 'short_val': 0, 'short_test': 0, 'gappy': 0}
MIN_TRAIN_LENGTH = SEQ + H
keep_cols = list(dict.fromkeys(['id', 'd_num', 'sales'] + PAST + FUT + STATIC))
for sid, g in sku_df.groupby('id', sort=False, observed=True):
    if sid not in sampled_set:
        continue
    g = g.sort_values('d_num').reset_index(drop=True)
    if not (g['d_num'].diff().dropna() == 1).all():
        excluded['gappy'] += 1
        continue
    tr, va, te = split_df(g)
    if len(tr) < MIN_TRAIN_LENGTH:
        excluded['short_train'] += 1; continue
    if len(va) < H:
        excluded['short_val'] += 1; continue
    if len(te) < H:
        excluded['short_test'] += 1; continue
    train_dfs.append(tr[keep_cols].copy())
    valid_dfs.append(va[keep_cols].copy())
    test_dfs.append(te[keep_cols].copy())
print(f"Train/Val/Test series: {len(train_dfs):,}/{len(valid_dfs):,}/{len(test_dfs):,}")
print(f"Excluded: {excluded}")
if not train_dfs:
    raise ValueError("Khong co chuoi du dai de train.")
del sampled_set; gc.collect()

# ---- 10. FINAL VALIDATION (mau 200 chuoi de nhanh, du Dai dien) ----
import random as _rd
for i in np.random.RandomState(42).choice(len(train_dfs), size=min(200, len(train_dfs)), replace=False):
    s = train_dfs[int(i)]
    if [c for c in REQUIRED_COLS if c not in s.columns]:
        raise ValueError(f"Train series #{i} thieu cot.")
    if not np.isfinite(s[NUMERIC_FEATURES].to_numpy(dtype=np.float64)).all():
        raise ValueError(f"Train series #{i} co NaN/Inf.")
    if (s['sales'] < 0).any():
        raise ValueError(f"Train series #{i} sales am.")
print("Final validation passed (200-series spot check).")

# ---- 11. FIT (lazy windows: ~7.5M windows nhung RAM ~2GB) ----
gc.collect()
try:
    import torch
    if torch.cuda.is_available():
        torch.cuda.empty_cache()
except Exception:
    pass
print("\n--- Training Global TFT FULL ---")
tft = TFTGlobalForecaster(
    PAST, FUT, STATIC,
    target='sales',
    seq=SEQ, H=H,
    d=TFT_CFG['d_model'],
    heads=TFT_CFG['num_heads'],
    lr=TFT_CFG['lr'],
    batch=TFT_CFG['batch_size'],
    epochs=TFT_CFG['epochs']
).fit(train_dfs)
print("\nTFT training completed.")
print(f"Training series: {len(train_dfs):,} | SEQ={SEQ} H={H}")

# ---- 12. SAVE CHECKPOINT NGAY (kernel restart khong mat) ----
tft.save(os.path.join(OUT_DIR, 'tft_global_full30490'))
del train_dfs, valid_dfs, test_dfs
gc.collect()
try:
    import torch
    if torch.cuda.is_available():
        torch.cuda.empty_cache()
except Exception:
    pass
