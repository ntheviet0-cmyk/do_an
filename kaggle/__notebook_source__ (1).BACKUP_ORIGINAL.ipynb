import gc
import glob
import os
import pickle
import shutil
import numpy as np
import pandas as pd
import torch

# ---- 0. guard: dung cell thieu thay vi NameError giua chung ----
for _need in ['sku_df', 'SEQ', 'H', 'OUT_DIR']:
    if _need not in globals():
        raise NameError(f"Thieu '{_need}': chay cell PIPELINE truoc.")
for _need in ['TFTGlobalForecaster', 'TFTGlobalNet']:
    if _need not in globals():
        raise NameError(f"Thieu '{_need}': chay cell DINH NGHIA MODEL truoc.")

# ---- 1. checkpoint INPUT (dataset attach) + OUT_DIR (ghi) ----
_hits = glob.glob('/kaggle/input/**/tft_global_full30490.weights.pt', recursive=True)
CKPT_IN = os.path.dirname(_hits[0]) if _hits else OUT_DIR
print('CKPT_IN =', CKPT_IN)
print('OUT_DIR =', repr(OUT_DIR))

# ---- 2. kernel moi restart -> nap model tu dataset input ----
if 'tft' not in globals():
    _w = os.path.join(CKPT_IN, 'tft_global_full30490.weights.pt')
    _m = os.path.join(CKPT_IN, 'tft_global_full30490.meta.pkl')
    if not (os.path.isfile(_w) and os.path.isfile(_m)):
        raise NameError(
            f"Chua co model (OUT_DIR={OUT_DIR!r}, CKPT_IN={CKPT_IN!r}): "
            "kiem tra dataset 'tft m5 checkpoint' da Add Input chua.")
    with open(_m, 'rb') as f:
        _meta = pickle.load(f)
    if _meta['seq'] != SEQ or _meta['H'] != H or _meta.get('target') != 'sales':
        raise ValueError(
            f"Checkpoint (seq={_meta['seq']}, H={_meta['H']}, target={_meta.get('target')!r}) "
            f"khac phien hien tai (seq={SEQ}, H={H}, target='sales') -> dung config hoac train lai.")
    tft = TFTGlobalForecaster(_meta['pc'], _meta['fc'], _meta['sc'],
        target=_meta['target'], seq=_meta['seq'], H=_meta['H'],
        d=_meta['d'], heads=_meta['heads'])
    tft.maps, tft.cards = _meta['maps'], _meta['cards']
    tft.ps, tft.fs, tft.ts = _meta['ps'], _meta['fs'], _meta['ts']
    tft.model = TFTGlobalNet(len(tft.pc), len(tft.fc), tft.cards,
                             tft.d, tft.heads, seq=tft.seq, H=tft.H).to(tft.device)
    _sd = torch.load(_w, map_location=tft.device)
    _mk = set(tft.model.state_dict().keys())
    _fixed, _n_remap = {}, 0
    for k, v in _sd.items():
        if k in _mk:
            _fixed[k] = v                                           # key khop san
        elif k.startswith('ctx.') and ('ctx.embs.' + k[4:]) in _mk:
            _fixed['ctx.embs.' + k[4:]] = v                         # doi cu -> moi
            _n_remap += 1
        elif k.startswith('ctx.embs.') and ('ctx.' + k[9:]) in _mk:
            _fixed['ctx.' + k[9:]] = v                              # doi moi -> cu
            _n_remap += 1
        else:
            _fixed[k] = v
    _missing, _unexpected = tft.model.load_state_dict(_fixed, strict=False)
    print('missing:', _missing)
    print('unexpected:', _unexpected)
    if _missing or _unexpected:
        print('CANH BAO: state_dict khong khop hoan toan — kiem tra lai kien truc/model.')
    tft.model.eval()
    print(f'loaded TFT tu dataset input ({_n_remap} key remap), khong can train lai')

def _split_one(g, key='d_num'):
    md = g[key].max()
    return (g[g[key] <= md - 56].copy(),
            g[(g[key] > md - 56) & (g[key] <= md - 28)].copy(),
            g[g[key] > md - 28].copy())

def _atomic_savez(path, d):
    tmp = path[:-4] + '.tmp.npz'
    np.savez(tmp, **d)
    os.replace(tmp, path)

def _atomic_pickle(path, obj):
    tmp = path + '.tmp'
    with open(tmp, 'wb') as f:
        pickle.dump(obj, f)
    os.replace(tmp, path)

# ---- 3. resume: uu tien working, thieu thi glob /kaggle/input/** va copy ve ----
CKPT_PRED = os.path.join(OUT_DIR, 'preds_tft_L12_ckpt.npz')
CKPT_TRUE = os.path.join(OUT_DIR, 'true_L12_ckpt.npz')
CKPT_META = os.path.join(OUT_DIR, 'meta_L12_ckpt.pkl')
CKPT_DONE = os.path.join(OUT_DIR, 'predict_done.txt')
