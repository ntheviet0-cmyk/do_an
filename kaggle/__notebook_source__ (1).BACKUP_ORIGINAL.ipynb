         'meta_L12_ckpt.pkl': CKPT_META, 'predict_done.txt': CKPT_DONE}
if not all(os.path.isfile(p) for p in _dsts.values()):
    _cands = {}
    for _fn in _dsts:
        for _h in glob.glob('/kaggle/input/**/' + _fn, recursive=True):
            _cands.setdefault(os.path.dirname(_h), {})[_fn] = _h
    if _cands:
        _src = max(_cands, key=lambda d: len(_cands[d]))
        print(f'resume source: {_src} ({len(_cands[_src])}/4 file)')
        for _fn, _dst in _dsts.items():
            if not os.path.isfile(_dst) and _fn in _cands[_src]:
                shutil.copy(_cands[_src][_fn], _dst)
                print(f'  copied {_fn} -> working')
    else:
        print('khong tim thay checkpoint du bao trong /kaggle/input -> se predict tu dau')

all_ids = sku_df['id'].drop_duplicates().tolist()
all_set = set(all_ids)
done, tft_L12, true_L12, meta_L12 = set(), {}, {}, {}
if os.path.isfile(CKPT_DONE):
    with open(CKPT_DONE) as f:
        done = set(l.strip() for l in f if l.strip())
if done and os.path.isfile(CKPT_PRED) and os.path.isfile(CKPT_TRUE) and os.path.isfile(CKPT_META):
    with np.load(CKPT_PRED) as _zp, np.load(CKPT_TRUE) as _zt:
        _pkeys = {k[5:] for k in _zp.files if k.startswith('pred_')}
        _tkeys = {k[5:] for k in _zt.files if k.startswith('true_')}
        with open(CKPT_META, 'rb') as f:
            _all_m = pickle.load(f)
        _valid = [k for k in done if k in _pkeys and k in _tkeys and k in _all_m and k in all_set]
        _lost = done - set(_valid)
        if _lost:
            print(f'CANH BAO: {len(_lost):,} id trong done.txt khong co du lieu day du -> predict lai')
        _bad = []
        for k in _valid:
            _p, _y = _zp[f'pred_{k}'], _zt[f'true_{k}']
            if _p.shape != (H,) or _y.shape != (H,):
                _bad.append(k)
                continue
            tft_L12[k], true_L12[k], meta_L12[k] = _p, _y, _all_m[k]
        if _bad:
            print(f'CANH BAO: {len(_bad):,} id sai shape (H={H}) -> predict lai')
    done = set(_valid) - set(_bad)
    print(f'resumed {len(done):,} series tu checkpoint')
elif done:
    print(f'CANH BAO: done.txt co {len(done):,} dong nhung thieu npz/meta -> predict lai tu dau')
    done = set()

# ---- 4. predict tung chuoi + checkpoint moi 5000 ----
todo = [s for s in all_ids if s not in done]
print(f'predict todo: {len(todo):,}/{len(all_ids):,}')

CHUNK = 5000
buf_p, buf_t, buf_m, buf_d = {}, {}, {}, []
skipped = 0
for n, sid in enumerate(todo, 1):
    g = sku_df[sku_df['id'] == sid].sort_values('d_num').reset_index(drop=True)
    tr, va, te = _split_one(g)
    if len(va) < H or len(te) < H:
        skipped += 1
        continue
    last = pd.concat([tr, va]).iloc[-SEQ:]
    y = te['sales'].values[:H]
    p = tft.predict_median(last, te)
    tft_L12[sid], true_L12[sid] = p, y
    meta_L12[sid] = (te['store_id'].iloc[0], te['state_id'].iloc[0], te['dept_id'].iloc[0])
    buf_p[f'pred_{sid}'] = np.asarray(p, dtype=np.float32)
    buf_t[f'true_{sid}'] = np.asarray(y, dtype=np.float32)
    buf_m[sid] = meta_L12[sid]
    buf_d.append(sid)
    if n % CHUNK == 0 or n == len(todo):
        old_p = dict(np.load(CKPT_PRED)) if os.path.isfile(CKPT_PRED) else {}
        old_t = dict(np.load(CKPT_TRUE)) if os.path.isfile(CKPT_TRUE) else {}
        old_p.update(buf_p)
        old_t.update(buf_t)
        _atomic_savez(CKPT_PRED, old_p)
        _atomic_savez(CKPT_TRUE, old_t)
        old_m = {}
        if os.path.isfile(CKPT_META):
            with open(CKPT_META, 'rb') as f:
                old_m = pickle.load(f)
        old_m.update(buf_m)
        _atomic_pickle(CKPT_META, old_m)
        with open(CKPT_DONE, 'a') as f:
            f.write('\n'.join(buf_d) + '\n')
            f.flush()
        buf_p, buf_t, buf_m, buf_d = {}, {}, {}, []
        gc.collect()
        if torch.cuda.is_available():
            torch.cuda.empty_cache()
        print(f'  ... xong {n:,}/{len(todo):,} (tong {len(done) + n:,}/{len(all_ids):,}, ckpt saved)')

print(f'PREDICT DONE: {len(tft_L12):,}/{len(all_ids):,} series | skipped: {skipped:,} | resumed: {len(done):,}')
