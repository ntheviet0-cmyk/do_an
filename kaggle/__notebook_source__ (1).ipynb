_ok_fin = True
for _i in range(PANEL.past.shape[0]):
    for _lo in range(0, PANEL.n_series, 5000):
        _hi = min(PANEL.n_series, _lo + 5000)
        if not np.isfinite(PANEL.past[_i, _lo:_hi, :]).all():
            _ok_fin = False
            break
    if not _ok_fin:
        print('Non-finite PAST feature index:', _i)
        break
_check('no NaN/Inf in model past features (matrix)', _ok_fin)
_check('no NaN/Inf in fut features (matrix)', bool(np.isfinite(PANEL.fut).all()))

# 5. FUT (known future) contains no sales/price leakage
_leak = [c for c in tft.fc if c.startswith('sales') or ('price' in c) or ('discount' in c)]
_check('FUT has no sales/price columns', not _leak, str(_leak))
if 'PAST' in globals():
    _check('checkpoint schema == notebook PAST/FUT/STATIC',
           list(map(str, tft.pc)) == list(map(str, PAST)) and list(map(str, tft.fc)) == list(map(str, FUT))
           and list(map(str, tft.sc)) == list(map(str, STATIC)), 'schema differs')

# 6. lag / rolling alignment tren 3 series mau (khong ro ri duong lai)
_ok_lag = True; _ok_roll = True; _ok_price = True
for _s in np.random.RandomState(42).choice(PANEL.n_series, size=3, replace=False):
    _s = int(_s)
    _sales = PANEL.past[0, _s, :].astype(np.float64)
    _lag28 = PANEL.past[1, _s, :].astype(np.float64)
    _lag35 = PANEL.past[2, _s, :].astype(np.float64)
    _roll7 = PANEL.past[3, _s, :].astype(np.float64)
    _plag = PANEL.past[5, _s, :].astype(np.float64)
    _t = np.arange(PANEL.n_days)
    _ok_lag &= bool(np.allclose(_lag28[28:], _sales[:PANEL.n_days - 28]))
    _ok_lag &= bool(np.allclose(_lag35[35:], _sales[:PANEL.n_days - 35]))
    # rolling_mean_7 = mean(sales[t-34 .. t-28])
    _cs = np.concatenate([[0.0], np.cumsum(_sales)])
    for _t in range(28, min(PANEL.n_days, 400)):
        _a = _t - 34; _b = _t - 28
        _lo = max(_a, 0)
        _exp = (_cs[_b + 1] - _cs[_lo]) / (_b - _lo + 1)
        if abs(_exp - _roll7[_t]) > 1e-3:
            _ok_roll = False
            break
    # sell_price_lag_28 phai bang 0 o 28 ngay dau (warmup fill)
    _ok_price &= bool(np.allclose(_plag[:28], 0.0))
_check('sales lag alignment (t-lag, lag>=28)', _ok_lag)
_check('rolling mean uses shift(28) then window', _ok_roll)
_check('warmup lag fill = 0 (first 28 days)', _ok_price)

