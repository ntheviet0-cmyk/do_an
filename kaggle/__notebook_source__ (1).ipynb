_a_min = TRAIN_TARGET_START - SEQ - 1
_a_max = TRAIN_TARGET_END - SEQ - H
_check('encoder window bounds fixed',
       _a_min == 0 and _a_max == TRAIN_TARGET_END - SEQ - H
