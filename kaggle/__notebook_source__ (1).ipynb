        'tft_cfg': TFT_CFG, 'sampling': SAMPLING, 'seq': SEQ, 'H': H,
        'log_target': LOG_TARGET, 'preprocess_version': PREPROCESS_VERSION,
        'config_version': CONFIG_VERSION, 'torch_version': torch.__version__,
        'n_train_series': int(len(eligible)), 'n_windows_per_epoch': tft.n_windows,
        'best_epoch': tft.best_epoch, 'best_val_loss': tft.best_val_loss,
        'stop_reason': tft.stop_reason, 'train_duration_s': tft.train_duration_s,
        'peak_rss_mb': tft.peak_rss_mb, 'peak_gpu_mb': tft.peak_gpu_mb,
        'panel_ram_mb': round(PANEL.memory_mb(), 1),
        'excluded': excluded,
    }, _f, indent=2, ensure_ascii=False, default=str)
print('saved training log + config')
del eligible
